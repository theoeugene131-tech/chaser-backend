# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Postgres connection string.
# Locally: point at a Postgres you're running yourself (see README "Local Postgres").
# On Railway: leave this line out entirely — Railway injects DATABASE_URL
# automatically once you `railway add` a Postgres plugin to the project.
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/chaser

# --- Integration credentials (all optional in demo mode) ---
# Connecting a provider from the app calls POST /api/integrations/:provider/connect
# with a JSON body of credentials, which are then stored per-org in the datastore.
# These env vars are only used if you wire up a server-side default/sandbox connection
# instead of connecting per-org through the API.

# Stripe
STRIPE_SECRET_KEY=

# QuickBooks Online (Intuit OAuth2)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# NetSuite (OAuth1 Token-Based Auth)
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# Bill.com
BILLCOM_ORG_ID=
BILLCOM_DEV_KEY=

# Coupa (OAuth2 client credentials)
COUPA_CLIENT_ID=
COUPA_CLIENT_SECRET=
